# Supabase (Gün 2'de devreye girecek)
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Yalnız sunucu tarafı (asla NEXT_PUBLIC yapmayın):
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Gün 12: TCMB kur çekme cron'unu korur (Vercel Cron otomatik gönderir)
CRON_SECRET=rastgele-uzun-bir-sir

# Opsiyonel — Yeni Ürün'de barkod okutunca ürün bilgisi otomatik doldurma.
# Boş bırakılırsa UPCitemdb'nin anahtarsız (günlük sınırlı) trial uç noktası
# kullanılır; anahtar tanımlanırsa aynı sağlayıcının ücretli uç noktasına
# otomatik geçilir (src/lib/barkod.ts).
BARKOD_API_ANAHTARI=
